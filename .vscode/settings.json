{
    "python.languageServer": "Pylance",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none",
        "reportShadowedImports": "none"
    },
    "python.analysis.stubPath": "pc/_stubs",
    "python.analysis.extraPaths": [
        "./lib",
        "./pc/_stubs",
        "./pc"
    ],
    "python.terminal.activateEnvironment": false,
    "python-envs.terminal.autoActivationType": "off",
    "circuitpython.board.version": null,
    "circuitpython.board.vid": "0x2E8A",
    "circuitpython.board.pid": "0x1026",
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.(py|toml|json|txt|csv)$",
                "isAsync": true,
                "cmd": "python \"${workspaceFolder}/.vscode/deska.py\" cpy save \"${relativeFile}\""
            }
        ]
    },
    "cSpell.language": "cs,en",
    "cSpell.enabledFileTypes": [
        "python",
        "plaintext",
        "markdown"
    ],
    "cSpell.words": [
        "picoed",
        "soubor",
        "typový",
        "určený",
        "Slouží",
        "doplňování",
        "sběrnici",
        "mikrokontroleru",
        "převodník",
        "časovače",
        "paměti",
        "vstupy",
        "výstupy",
        "modulace",
        "sériová",
        "komunikace",
        "reset",
        "frekvence",
        "vlákna",
        "stavové",
        "stroje",
        "PIO",
        "RP2040",
        "ELECFREAKS",
        "digitalio",
        "microbit",
        "Pythonu",
        "adafruit",
        "analogio",
        "AUDIOPLAY",
        "AUDIOSYNC",
        "AUTOPLAY",
        "autoreload",
        "bashi",
        "BOOTSEL",
        "busio",
        "CIRCUITPY",
        "circuitpython",
        "circup",
        "DADADADUM",
        "deinit",
        "Dopieralski",
        "elif",
        "emeraldwalk",
        "GRBW",
        "HALFPERIOD",
        "konzoli",
        "matplotlib",
        "microcontroller",
        "micropython",
        "mikrokontrolér",
        "mikrokontroléru",
        "miniterm",
        "mpremote",
        "neopixel",
        "NYAN",
        "ploter",
        "pwmio",
        "pycache",
        "pyrightconfig",
        "pyserial",
        "Pythonem",
        "Přenačíst",
        "readfrom",
        "repozitář",
        "repozitáři",
        "RGBW",
        "rozbalovacím",
        "runmain",
        "runonsave",
        "Shellu",
        "smajlíka",
        "SMPS",
        "stuby",
        "Thonny",
        "uasyncio",
        "ufeff",
        "VBUS",
        "WAWAWAWAA",
        "wmerkens",
        "writeto",
        "zaroluje",
        "numpy",
        "setupu",
        "venv",
        "NTFS",
        "flashce",
        "Enteru",
        "TCSADRAIN",
        "getwch",
        "kbhit",
        "tcgetattr",
        "tcsetattr"
    ],
    "cSpell.ignorePaths": [
        "**/*.pyi"
    ],
    "spellright.ignoreRegExpList": [
        ".*\\.pyi$"
    ],
    "micropython.enableStatusToolbar": true,
    "micropython.autoOpenPanel": true,
    "micropython.commands": [
        {
            "id": "mpy-upload",
            "name": "$(cloud-upload) MPY Upload",
            "label": "⬆  Nahrát projekt",
            "command": "python .vscode/deska.py mpy upload",
            "color": "yellow",
            "group": "MicroPython",
            "platform": "micropython"
        },
        {
            "id": "mpy-run",
            "name": "$(play) MPY Run",
            "label": "▶  Spustit main.py",
            "command": "python .vscode/deska.py mpy reset",
            "color": "lightgreen",
            "group": "MicroPython",
            "platform": "micropython",
            "statusBar": false
        },
        {
            "id": "mpy-repl",
            "name": "$(terminal) MPY REPL",
            "label": "⌨  Konzole (REPL)",
            "command": "python .vscode/deska.py mpy repl",
            "color": "lightblue",
            "group": "MicroPython",
            "platform": "micropython"
        },
        {
            "id": "mpy-wipe",
            "name": "$(trash) MPY Wipe",
            "label": "🗑  Smazat desku",
            "command": "python .vscode/deska.py mpy wipe --yes",
            "color": "red",
            "group": "MicroPython",
            "platform": "micropython",
            "statusBar": false,
            "confirm": "Smazat VŠECHNY soubory na desce s MicroPythonem? Operace je nevratná.",
            "confirmButton": "Smazat"
        },
        {
            "id": "cpy-upload",
            "name": "$(cloud-upload) CPY Upload",
            "label": "⬆  Nahrát projekt",
            "command": "python .vscode/deska.py cpy upload",
            "color": "yellow",
            "group": "CircuitPython",
            "platform": "circuitpython"
        },
        {
            "id": "cpy-reset",
            "name": "$(debug-restart) CPY Restart",
            "label": "↻  Restartovat program",
            "command": "python .vscode/deska.py cpy reset",
            "color": "lightgreen",
            "group": "CircuitPython",
            "platform": "circuitpython",
            "statusBar": false
        },
        {
            "id": "cpy-repl",
            "name": "$(terminal) CPY REPL",
            "label": "⌨  Konzole (REPL)",
            "command": "python .vscode/deska.py cpy repl",
            "color": "lightblue",
            "group": "CircuitPython",
            "platform": "circuitpython"
        },
        {
            "id": "cpy-wipe",
            "name": "$(trash) CPY Wipe",
            "label": "🗑  Smazat desku",
            "command": "python .vscode/deska.py cpy wipe --yes",
            "color": "red",
            "group": "CircuitPython",
            "platform": "circuitpython",
            "statusBar": false,
            "confirm": "Smazat VŠECHNY soubory na disku CIRCUITPY? Operace je nevratná.",
            "confirmButton": "Smazat"
        },
        {
            "id": "pc-sim",
            "name": "$(debug-alt) Simulace",
            "label": "▶  Simulace code.py",
            "command": "python .vscode/deska.py cpy sim",
            "color": "lightgreen",
            "group": "Na PC bez desky",
            "statusBar": false
        },
        {
            "id": "pc-test",
            "name": "$(beaker) Testy",
            "label": "✓  Testy",
            "command": "python .vscode/deska.py cpy test",
            "color": "lightblue",
            "group": "Na PC bez desky",
            "statusBar": false
        }
    ],
    "micropython.devicesCommand": "python .vscode/deska.py devices --json"
}
